# Neon PostgreSQL (one project, one schema per service)
# Paste the connection string from the Neon dashboard as-is; services
# normalize postgresql:// to the psycopg v3 driver internally.
DATABASE_URL=postgresql://user:password@host/riskgate?sslmode=require

# Groq API (Investigation Agent — Milestone 7)
GROQ_API_KEY=

# Service-to-service URLs (defaults suit local uv runs; compose overrides them)
# LEDGER_SERVICE_URL=http://localhost:8003

# Service ports (local development)
BANKING_SERVICE_PORT=8001
TRANSACTION_SERVICE_PORT=8002
LEDGER_SERVICE_PORT=8003
RISK_SERVICE_PORT=8004
INVESTIGATION_SERVICE_PORT=8005
